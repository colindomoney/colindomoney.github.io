---
// now.json is synced automatically from colindomoney.com — do not edit here.
// Text supports minimal markdown (*italic* / **bold**) rendered by renderNowText.
import now from '../data/now.json';
import { renderNowText } from '../lib/nowText';

interface Props {
  variant: 'a' | 'b';
}
const { variant } = Astro.props;
const sections = now.sections;
const last = sections.length - 1;
---

{variant === 'a' && (
  <section class="currently">
    <span class="currently__label">Currently</span>
    <div class="currently__grid">
      {sections.map((s, i) => (
        <div class="currently__item" style={i === last ? 'grid-column: 1 / -1' : undefined}>
          <h4>{s.title}</h4>
          <p set:html={renderNowText(s.text)} />
        </div>
      ))}
    </div>
  </section>
)}

{variant === 'b' && (
  <div class="vb__currently">
    <div class="vb__section-label">Currently</div>
    {sections.map((s) => (
      <>
        <h4>{s.title}</h4>
        <p set:html={renderNowText(s.text)} />
      </>
    ))}
  </div>
)}
